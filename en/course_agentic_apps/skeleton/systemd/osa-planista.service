[Unit]
Description=OSA agent scheduler (part 11)
After=osa-brama.service
Requires=osa-brama.service

[Service]
Type=simple
WorkingDirectory=@OSA@
ExecStart=@OSA@/.venv/bin/python @OSA@/harmonogram/planista.py
Restart=on-failure
RestartSec=30
StartLimitBurst=5
StartLimitIntervalSec=600
NoNewPrivileges=yes

[Install]
WantedBy=default.target
