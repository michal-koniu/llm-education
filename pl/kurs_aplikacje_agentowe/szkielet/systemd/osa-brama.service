[Unit]
Description=Brama systemu agentów OSA
After=network.target

[Service]
Type=simple
WorkingDirectory=@OSA@
ExecStart=@OSA@/.venv/bin/python @OSA@/brama.py
Restart=on-failure
RestartSec=10
StartLimitBurst=5
StartLimitIntervalSec=600
# Zawężenie: brama nie potrzebuje niczego poza swoim katalogiem
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=@OSA@ %h/.local/run

[Install]
WantedBy=default.target
